* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Ship the full runnable bundle (container images + vuln DBs) THROUGH GitLab via
# Git LFS, so a plain `git clone` brings everything and the stack starts with one
# command — no scp/USB.  Requires git-lfs on both ends + LFS enabled on GitLab.
bundle/**/*.tar filter=lfs diff=lfs merge=lfs -text
bundle/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
bundle/*.tar filter=lfs diff=lfs merge=lfs -text
bundle/*.tar.gz filter=lfs diff=lfs merge=lfs -text
