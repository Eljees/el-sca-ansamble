* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Ship the whole runnable bundle (container images + vuln DBs) INSIDE the repo
# via Git LFS, so a plain `git clone` brings everything and the stack deploys
# with one command — nothing copied by hand.  Needs git-lfs + GitLab LFS (on by
# default on self-managed GitLab).
bundle/*.tar filter=lfs diff=lfs merge=lfs -text
bundle/*.tar.gz filter=lfs diff=lfs merge=lfs -text
