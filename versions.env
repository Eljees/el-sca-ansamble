# Single source of truth for upstream scanner / sidecar image tags.
#
# docker-compose.yml resolves these through ${VAR:-fallback} so the file
# can be sourced before `docker compose up` (or kept implicit, in which
# case compose uses the fallback that matches this file).
#
# When you bump a version here, also update:
#   - docker-compose.yml fallback to match
#   - docs/operations.md examples that mention an explicit tag
# The CI `lint-versions` job in .github/workflows/ci.yml verifies this
# automatically.  versions.env, pyproject.toml and docker-compose.yml must agree.

# ── Project version (this repo, SemVer) ───────────────────────────────
# Bump on every feature/fix batch BEFORE pushing to GitLab and move the
# CHANGELOG "[Unreleased]" block into a "[x.y.z] - DATE" release. See
# docs/RELEASING.md for the pre-push checklist. Tag the commit: git tag vX.Y.Z
EL_SCA_VERSION=0.1.5

# ── Vulnerability scanners ────────────────────────────────────────────
TRIVY_VERSION=0.73.0
GRYPE_VERSION=v0.116.1
SYFT_VERSION=v1.50.0
CVE_BIN_TOOL_VERSION=3.4
OSV_SCANNER_VERSION=latest

# ── Network sidecars ───────────────────────────────────────────────────
XRAY_VERSION=latest
TINYPROXY_VERSION=latest
WIREGUARD_VERSION=latest

# ── Storage sidecars (internal S3) ─────────────────────────────────────
# Pinned deliberately: `latest` silently drifted the S3 layer (4.38 introduced
# an STS/IAM subsystem that logs "Failed to load IAM configuration: no signing
# key found for STS service" at startup — harmless for the static identities in
# configs/seaweedfs/s3.json, but the drift itself breaks reproducibility).
SEAWEEDFS_VERSION=4.38
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ── Base images we build on top of (resilient-updater, extractor, ...) ─
PYTHON_BASE_IMAGE=python:3.12-slim

# ── Build-time tuning ─────────────────────────────────────────────────
# JVM heap for Dockerfile.apk-analyzer.  Override via --build-arg or .env.
JAVA_XMX=512m
