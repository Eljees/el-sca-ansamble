# ---------------------------------------------------------------------------
# Scan targets (override per-run or leave as defaults)
# ---------------------------------------------------------------------------
TRIVY_TARGET=alpine:latest
GRYPE_TARGET=alpine:latest
SYFT_TARGET=alpine:latest
SYFT_FROM=registry
CVE_BIN_TOOL_TARGET=/scan-target

# ---------------------------------------------------------------------------
# Registry credentials (replace with real values)
# ---------------------------------------------------------------------------
TRIVY_INTERNAL_REGISTRY_USERNAME=
TRIVY_INTERNAL_REGISTRY_PASSWORD=
GRYPE_CUSTOM_AUTH_TOKEN=
CVE_BIN_TOOL_MIRROR_TOKEN=
SYFT_REGISTRY_USERNAME=
SYFT_REGISTRY_PASSWORD=

# ---------------------------------------------------------------------------
# Linux UID/GID for mounted artifacts (adjust if permission errors appear)
# ---------------------------------------------------------------------------
LOCAL_UID=1000
LOCAL_GID=1000

# ---------------------------------------------------------------------------
# cve-bin-tool scan timeout
#
# cve-bin-tool runs 365 binary regex checkers against every file in the scan
# target directory.  Large Go/C binaries (e.g. Prometheus ~100 MB) can take
# tens of minutes per file.  Set a wall-clock limit so the pipeline never
# hangs indefinitely; on timeout an empty report is written and the pipeline
# continues.  Increase for very large targets or reduce for fast CI runs.
#
# Default: 600 seconds (10 minutes).  Set to 0 to disable (not recommended).
# ---------------------------------------------------------------------------
CVE_BIN_TOOL_SCAN_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Grype DB age validation
#
# Grype refuses to scan if the vulnerability database was built more than
# GRYPE_DB_MAX_ALLOWED_BUILT_AGE ago.  In air-gapped / infrequently-updated
# environments the default 72h limit is too strict.  Increase as needed, or
# set GRYPE_DB_VALIDATE_AGE=false to disable the check entirely.
#
# Default: 168h (7 days).  GRYPE_DB_VALIDATE_AGE default: true.
# ---------------------------------------------------------------------------
GRYPE_DB_MAX_ALLOWED_BUILT_AGE=168h
# GRYPE_DB_VALIDATE_AGE=false

# ---------------------------------------------------------------------------
# Proxy settings
#
# All proxy variables are optional and default to empty (direct connection).
# Set them if the Docker host reaches the internet via a proxy.
#
# IMPORTANT — 127.0.0.1 inside a Docker container refers to the container,
# not the host machine.  Use host.docker.internal to reach a proxy that
# listens on the Windows/Linux host (extra_hosts is already wired in
# docker-compose.yml so the name resolves automatically).
#
# SOCKS5 proxy on the local machine (most common setup):
#   ALL_PROXY=socks5h://host.docker.internal:1080
#   NO_PROXY=localhost,127.0.0.1,grype-static
#
# Corporate HTTP/HTTPS proxy:
#   HTTP_PROXY=http://proxy.corp.example:3128
#   HTTPS_PROXY=http://proxy.corp.example:3128
#   NO_PROXY=localhost,127.0.0.1,grype-static,.corp.example
#
# Scheme notes:
#   socks5  — SOCKS5, proxy resolves DNS
#   socks5h — SOCKS5, remote (proxy) resolves DNS  ← preferred for corp proxies
#   socks4a — SOCKS4a with remote DNS
# ---------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,grype-static
ALL_PROXY=socks5h://host.docker.internal:1080

# ---------------------------------------------------------------------------
# Sidecar proxy chain (profile "proxy", see docs/network-design.md)
#
# When you enable the proxy sidecars with:
#
#   COMPOSE_PROFILES=scan,update,proxy docker compose up -d
#
# uncomment the variables below INSTEAD of the host.docker.internal ones
# above.  Scanners then connect to in-cluster tinyproxy/xray, and 