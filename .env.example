# ---------------------------------------------------------------------------
# Scan targets (override per-run or leave as defaults)
# ---------------------------------------------------------------------------
TRIVY_TARGET=alpine:latest
GRYPE_TARGET=alpine:latest
SYFT_TARGET=alpine:latest
SYFT_FROM=registry
CVE_BIN_TOOL_TARGET=/scan-target

# ---------------------------------------------------------------------------
# Registry credentials (replace with real values)
# ---------------------------------------------------------------------------
TRIVY_INTERNAL_REGISTRY_USERNAME=
TRIVY_INTERNAL_REGISTRY_PASSWORD=
GRYPE_CUSTOM_AUTH_TOKEN=
CVE_BIN_TOOL_MIRROR_TOKEN=
SYFT_REGISTRY_USERNAME=
SYFT_REGISTRY_PASSWORD=

# ---------------------------------------------------------------------------
# Linux UID/GID for mounted artifacts (adjust if permission errors appear)
# ---------------------------------------------------------------------------
LOCAL_UID=1000
LOCAL_GID=1000

# ---------------------------------------------------------------------------
# cve-bin-tool scan timeout
#
# cve-bin-tool runs 365 binary regex checkers against every file in the scan
# target directory.  Large Go/C binaries (e.g. Prometheus ~100 MB) can take
# tens of minutes per file.  Set a wall-clock limit so the pipeline never
# hangs indefinitely; on timeout an empty report is written and the pipeline
# continues.  Increase for very large targets or reduce for fast CI runs.
#
# Default: 600 seconds (10 minutes).  Set to 0 to disable (not recommended).
# ---------------------------------------------------------------------------
CVE_BIN_TOOL_SCAN_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Extractor pre-filter (Phase 3.5 — Windows acceleration)
# ---------------------------------------------------------------------------
# Skip individual archive members larger than this many MB.  Set to 0 to
# disable the limit.  Default is 0 (no skipping) so legacy behaviour is
# unchanged.  Recommended ceiling for Windows + WSL2: 200-500.
EXTRACT_MAX_MEMBER_SIZE_MB=0

# Per-tool parallelism for cve-bin-tool's binary regex scan.
# Empty = auto (½ of nproc, capped at 8).  Set to 0/1 for serial, or a
# specific integer to pin the worker count.
CVE_BIN_TOOL_PARALLEL=

# ---------------------------------------------------------------------------
# cve-bin-tool: SBOM fast-path auto-detection
#
# When the syft-sbom step already produced a SBOM under artifacts/sbom/,
# update_cve_bin_tool.sh now uses it automatically (DB lookup, seconds
# instead of 10+ minutes of regex scan).  Disable with =0 to force the
# binary scan path (debug only).
# ---------------------------------------------------------------------------
CVE_BIN_TOOL_AUTO_SBOM=1

# ---------------------------------------------------------------------------
# Go runtime injection into SBOM
#
# syft's CycloneDX SBOM lists Go *module* dependencies but omits the Go
# *runtime* (golang:go X.Y.Z) because syft reports packages, not the
# toolchain that built them.  cve-bin-tool's Go checker finds runtime CVEs
# such as CVE-2024-3566 only when the runtime appears as a component.
#
# When enabled (default), the pipeline extracts the Go version from
# go:buildinfo inside the target binaries and injects it into a temporary
# copy of the SBOM before feeding it to cve-bin-tool.
#
# Disable with =0 if you want the raw syft SBOM without the runtime entry.
# ---------------------------------------------------------------------------
CVE_BIN_TOOL_INJECT_GO_RUNTIME=1

# Skip files larger than this many MB during the binary fallback path.
# Oversize artefacts (typically large Go monoliths with bundled assets) blow
# up regex backtracking and wedge the scan; we'd rather miss one outlier
# than hang for an hour.  Set to 0 to disable the filter.
CVE_BIN_TOOL_MAX_FILE_MB=256

# ---------------------------------------------------------------------------
# Extractor pre-filter (opt-in via run-time args; no env switch needed)
#
# Phase 3.5 adds member-level filters to resilient_updates/extractor.py:
#   --max-member-size-mb N   skip archive members larger than N MB
#   --skip-ext .png          skip members ending with this extension
#                            (pass multiple times: --skip-ext .png --skip-ext .ttf)
#
# Override the default extractor command to use them:
#
#   docker compose --profile extract run --rm artifact-extractor \
#     --input /input --output /workspace/artifacts/extracted/current \
#     --max-depth 4 --max-files 20000 --max-bytes 10737418240 \
#     --max-member-size-mb 50 \
#     --skip-ext .png --skip-ext .jpg --skip-ext .ttf --skip-ext .woff2
#
# Counts and a 20-item sample of skipped members land in extraction_manifest.json
# under the "pre_filter" key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Grype DB age validation
#
# Grype refuses to scan if the vulnerability database was built more than
# GRYPE_DB_MAX_ALLOWED_BUILT_AGE ago.  In air-gapped / infrequently-updated
# environments the default 72h limit is too strict.  Increase as needed, or
# set GRYPE_DB_VALIDATE_AGE=false to disable the check entirely.
#
# Default: 168h (7 days).  GRYPE_DB_VALIDATE_AGE default: true.
# ---------------------------------------------------------------------------
GRYPE_DB_MAX_ALLOWED_BUILT_AGE=168h
# GRYPE_DB_VALIDATE_AGE=false

# ---------------------------------------------------------------------------
# Proxy settings
#
# All proxy variables are optional and default to empty (direct connection).
# Set them if the Docker host reaches the internet via a proxy.
#
# IMPORTANT — 127.0.0.1 inside a Docker container refers to the container,
# not the host machine.  Use host.docker.internal to reach a proxy that
# listens on the Windows/Linux host (extra_hosts is already wired in
# docker-compose.yml so the name resolves automatically).
#
# SOCKS5 proxy on the local machine (most common setup):
#   ALL_PROXY=socks5h://host.docker.internal:1080
#   NO_PROXY=localhost,127.0.0.1,grype-static
#
# Corporate HTTP/HTTPS proxy:
#   HTTP_PROXY=http://proxy.corp.example:3128
#   HTTPS_PROXY=http://proxy.corp.example:3128
#   NO_PROXY=localhost,127.0.0.1,grype-static,.corp.example
#
# Scheme notes:
#   socks5  — SOCKS5, proxy resolves DNS
#   socks5h — SOCKS5, remote (proxy) resolves DNS  ← preferred for corp proxies
#   socks4a — SOCKS4a with remote DNS
# ---------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,grype-static
ALL_PROXY=socks5h://host.docker.internal:1080

# ---------------------------------------------------------------------------
# Sidecar proxy chain (profile "proxy", see docs/network-design.md)
#
# When you enable the proxy sidecars with:
#
#   COMPOSE_PROFILES=scan,update,proxy docker compose up -d
#
# uncomment the variables below INSTEAD of the host.docker.internal ones
# above.  Scanners then connect to in-cluster tinyproxy/xray, and the entire
# outbound chain (corp proxy / VPN / direct) is configured in one place via
# configs/xray/config.json.
#
#   HTTP_PROXY=http://tinyproxy:8888
#   HTTPS_PROXY=http://tinyproxy:8888
#   ALL_PROXY=socks5h://proxy-xray:1080
#   NO_PROXY=localhost,127.0.0.1,grype-static,tinyproxy,proxy-xray
#
# Optional VPN profile (profile "vpn"): drop wg0.conf into configs/wireguard/
# then start with COMPOSE_PROFILES=scan,update,proxy,vpn.  The wireguard
# sidecar joins scanner-net; route the xray "upstream" outbound through it.
# ---------------------------------------------------------------------------


