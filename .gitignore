.env
.env.local
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
Thumbs.db
-prompts/
.vscode/
_el_cvebt_source_research/
--exps/
comands.txt
to_analyze/
docker-compose.prod.yml
# Local per-machine Docker Compose overrides (not for commit).
# docker-compose.override.yml is auto-loaded by compose and is host-specific.
docker-compose.override.yml
docker-compose.port.override.yml

artifacts/cache/*
artifacts/extracted/*
artifacts/mirror/*
artifacts/internal/*
artifacts/reports/*
artifacts/provenance/*
artifacts/sbom/*
# DB bundle export staging (db-exporter) and import staging (db-importer).
# These hold multi-GB vulnerability-DB tarballs and must never be committed.
artifacts/db-image/
# NVD 2.0 JSON feeds downloaded by scripts/fetch_nvd_feeds.ps1 (host-side
# source for the cve-bin-tool "feed" import). ~190 MB; regenerable, never commit.
artifacts/nvd-feeds/
incoming/
# Runtime JSON outputs written by resilient_updates.run_summary / manifest
# (db_snapshot.json, run_manifest.json, status.json, summary.json, …).
# These are per-run artefacts and must not be committed.
artifacts/*.json
!artifacts/extracted/.gitkeep
!artifacts/**/.gitkeep

# route-doctor output (ADR-0007 P2): per-host egress plan + generated xray
# upstream config. Runtime, host-specific — never commit.
artifacts/route-plan.env
configs/xray/config.gen.json

docker-auth.json
.docker/
credentials/
secrets/

# Runtime proxy-chain override written by the dashboard toggle.
# Static defaults live in configs/feed_sources.yaml (tracked).
configs/feed_sources.runtime.yaml

# WireGuard configuration — actual wg0.conf is host-specific and contains
# private keys.  Keep the example template, ignore the real config.
configs/wireguard/wg0.conf

# Batch job lists.  batches/example.* are committed templates;
# anything else (daily.csv, weekly.json etc.) typically contains
# local CYBERSEC ticket paths and stays out of git.
batches/*
!batches/README.md
!batches/example.csv
!batches/example.json
tmp/
temp/
*.tmp
*.bak
*.zip
*.tar
*.tar.gz
*.db
*.sqlite
*.sqlite3

.coverage
.coverage.*

# Root-level per-run scanner output files (e.g. output.cve-bin-tool.*.json)
output.*.json

# Container image bundle staging (docker save) — multi-GB, never commit.
artifacts/image-bundle/
incoming/images.tar

# Per-run scan log + DB status snapshots (runtime output, not source).
artifacts/run-scan.log
artifacts/db_status/

# *.tar / *.tar.gz are ignored above, but the LFS-tracked deploy bundle MUST be
# committed so `git clone` brings the runnable images + DBs. Un-ignore it.
!bundle/
!bundle/*.tar
!bundle/*.tar.gz

# Background-scan job records written by tools/docker-mcp run_scan_async.
artifacts/mcp-jobs/
artifacts/run-scan.log*

# Container-ID scratch files + done-markers + one-off comparison artifacts
# (session leftovers from interactive debugging — must not reach git).
artifacts/*.done
artifacts/_local_*.txt
artifacts/_*.py
artifacts/COMPARISON*.md

# Session-completion scratch notes (not source, not docs)
docs/олл-ок.txt

# Per-run history snapshots and local enrichment feeds (EPSS/KEV).
artifacts/runs/
artifacts/enrichment/

# temp freshcopy/fc editor artifacts
*.fc
*.fc2
*.freshcopy

# session output files
*.out
push.log
rp.out
