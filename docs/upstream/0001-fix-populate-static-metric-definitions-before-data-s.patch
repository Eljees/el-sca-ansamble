From a6b14f8c5f6a2e92c73ae4b023859a1e2b7a23f5 Mon Sep 17 00:00:00 2001
From: Elaria <3.14hell@gmail.com>
Date: Thu, 16 Jul 2026 17:25:48 +0300
Subject: [PATCH] fix: populate static metric definitions before data sources
 are gathered

CVEDB.refresh_cache_and_update_db() runs the source gather
(run_coroutine(self.refresh()) -> get_data() -> source.get_cve_data())
before populate_db() -> populate_metrics() has inserted the static
metric rows, so any source that resolves its metric id from the
metrics table during the gather reads an empty (or missing) table.

In the released 3.4 this is a real crash: Epss_Source.EPSS_id_finder()
does fetchall()[0][0] on that empty table and dies with IndexError
(swallowed by get_cve_data()'s broad except, so EPSS silently ends at
0 entries with "Unable to fetch EPSS, skipping EPSS."). On main the
EPSS source now uses the EPSS_METRIC_ID constant instead of a lookup,
which masks the crash, but the ordering itself is unchanged: metric
definitions are still written only after every source has finished
gathering, and init_database() grew an ensure_unknown_metric() band-aid
for one of the rows.

Hoist init_database() + populate_metrics() above the gather in
refresh_cache_and_update_db() and drop the now-redundant call in
populate_db(). Both hoisted calls are idempotent (CREATE TABLE IF NOT
EXISTS / INSERT or REPLACE) and depend on no source output. Add a
cachedir existence guard because refresh() used to create it first.

The comment in populate_db() ("It can't be run before creation of
metrics table.") already knew about the dependency; this change makes
the order actually satisfy it. Applies cleanly to v3.4 as well for
anyone backporting.

Signed-off-by: Elaria <3.14hell@gmail.com>
---
 cve_bin_tool/cvedb.py | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/cve_bin_tool/cvedb.py b/cve_bin_tool/cvedb.py
index df8de1a..d4ef7d6 100644
--- a/cve_bin_tool/cvedb.py
+++ b/cve_bin_tool/cvedb.py
@@ -300,11 +300,20 @@ class CVEDB:
     def refresh_cache_and_update_db(self) -> None:
         """Refresh cached NVD and update CVE database with latest data."""
         self.LOGGER.debug("Updating CVE data. This will take a few minutes.")
+        # Make sure the database schema and the static metric definitions
+        # exist BEFORE data sources are gathered: sources may resolve
+        # metric ids from the metrics table while fetching (e.g.
+        # Epss_Source.EPSS_id_finder() in 3.4), so populating metrics only
+        # after the gather is too late. Both calls are idempotent and
+        # depend on no source output.
+        if not self.cachedir.is_dir():
+            self.cachedir.mkdir(parents=True)
+        # if the database isn't open, open it
+        self.init_database()
+        self.populate_metrics()
         # refresh the nvd cache
         run_coroutine(self.refresh())
 
-        # if the database isn't open, open it
-        self.init_database()
         self.populate_db()
         self.LOGGER.debug("Updating exploits data.")
         self.create_exploit_db()
@@ -481,10 +490,6 @@ class CVEDB:
         we'll need a better parser to match those together.
         """
 
-        self.populate_metrics()
-        # EPSS uses metrics table to get the EPSS metric id.
-        # It can't be run before creation of metrics table.
-
         for idx, data in enumerate(self.data):
             _, source_name = data
 
