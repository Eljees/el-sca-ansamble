# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

# 7zip for NSIS extraction; msitools for MSI; binutils + file for PE inspection
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      7zip \
      innoextract \
      msitools \
      binutils \
      file \
      python3-pefile

# Create a non-root user (CIS Docker Benchmark 4.1).
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 1001 appuser \
    && mkdir -p /workspace /scripts /home/appuser/.cache \
    && chown -R appuser:appuser /workspace /scripts /home/appuser/.cache

RUN --mount=type=cache,target=/home/appuser/.cache/pip,sharing=locked,uid=1001 \
    pip install "pefile>=2023.2.7"

COPY --chown=appuser:appuser scripts/analyze_win_installer.py /scripts/analyze_win_installer.py

USER appuser

ENTRYPOINT ["python", "/scripts/analyze_win_installer.py"]
